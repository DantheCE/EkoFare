# ──────────────────────────────────────────────────────────────────────────────
# EkoFare API — environment (build spec §2.1). Copy to .env and adjust.
# Defaults below match docker-compose.yml so `infra:up` + these values just work.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required).
DATABASE_URL=postgresql://postgres:password@localhost:5432/ekofare

# Redis (optional). Unset → the API runs without a cache (every read computes
# live). Set it for stampede-protected caching in production.
REDIS_URL=redis://localhost:6379

# Admin auth (optional; admin endpoints are disabled until all three are set).
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Server.
PORT=3001
NODE_ENV=development

# Consensus + routing tunables.
RATE_LIMIT_CONTRIB_PER_HOUR=5
MIN_REPORTS_FOR_ROUTING=3
OUTLIER_SIGMA=2
ROUTE_CACHE_TTL_SECONDS=300
