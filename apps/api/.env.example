# ──────────────────────────────────────────────────────────────────────────────
# EkoFare API Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust values as needed.

# PostgreSQL connection string (required for the backend).
DATABASE_URL=postgresql://postgres:password@localhost:5432/ekofare

# Number of confirmations required to promote a pending contribution to verified.
# Default: 3
VERIFICATION_THRESHOLD=3

# Port for the Express server.
# Default: 3001
PORT=3001
