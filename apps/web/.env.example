# ──────────────────────────────────────────────────────────────────────────────
# EkoFare Frontend Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and adjust values as needed.
# For frontend-only (mock mode), no env file is required — all defaults work.

# Set to "false" to hit the real Express API instead of in-memory mock data.
# Default: "true" (mock mode — no backend or database required).
NEXT_PUBLIC_USE_MOCKS=true

# Base URL of the Express API server.
# Only used when NEXT_PUBLIC_USE_MOCKS=false.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
